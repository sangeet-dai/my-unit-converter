@{
    var code = (int)(ViewBag.Code ?? 404);
}

<section class="lh-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="lh-detail-panel">
                    <span class="lh-kicker">@(code == 404 ? "404" : "Error " + code)</span>
                    <h1 class="mt-2 mb-3">
                        @(code == 404 ? "We could not find that page" : "Something went wrong")
                    </h1>
                    <p class="text-muted mb-4">
                        @if (code == 404)
                        {
                            <text>The resource or page you asked for is not in the library. It may have
                            been removed by an administrator, or the address may be mistyped.</text>
                        }
                        else
                        {
                            <text>The request could not be completed. Please try again, or return to the catalogue.</text>
                        }
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Resources" asp-action="Index" class="btn btn-lh-accent">Browse the catalogue</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-lh-outline">Back to home</a>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-link">Report a problem</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
