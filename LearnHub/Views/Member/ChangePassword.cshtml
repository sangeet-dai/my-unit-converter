@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<header class="lh-page-header">
    <div class="container">
        <nav class="lh-breadcrumb mb-1" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a> &rsaquo;
            <a asp-controller="Member" asp-action="Dashboard">Dashboard</a> &rsaquo;
            <span class="text-white">Change password</span>
        </nav>
        <h1 class="fw-bold">Change my password</h1>
    </div>
</header>

<section class="lh-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="lh-form-card">
                    <form asp-controller="Member" asp-action="ChangePassword" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger lh-alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="lh-form-label">Current password</label>
                            <input asp-for="CurrentPassword" class="form-control lh-form-control" type="password"
                                   autocomplete="current-password" required />
                            <span asp-validation-for="CurrentPassword"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="lh-form-label">New password</label>
                            <input asp-for="NewPassword" class="form-control lh-form-control" type="password"
                                   autocomplete="new-password" minlength="8"
                                   pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+"
                                   title="At least 8 characters with one uppercase letter, one lowercase letter and one digit."
                                   aria-describedby="newPwHelp" required />
                            <span asp-validation-for="NewPassword"></span>
                        </div>
                        <small id="newPwHelp" class="text-muted d-block mb-3">
                            Minimum 8 characters with an uppercase letter, a lowercase letter and a digit.
                        </small>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="lh-form-label">Confirm new password</label>
                            <input asp-for="ConfirmPassword" class="form-control lh-form-control" type="password"
                                   autocomplete="new-password" required />
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <button type="submit" class="btn btn-lh-primary"><i class="ti ti-key me-1"></i>Update password</button>
                        <a asp-controller="Member" asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
