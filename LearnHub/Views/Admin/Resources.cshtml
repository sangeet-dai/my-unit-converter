@model List<LearningResource>
@{
    ViewData["Title"] = "Manage Resources";
}

<header class="lh-page-header">
    <div class="container">
        <nav class="lh-breadcrumb mb-1" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a> &rsaquo;
            <a asp-controller="Admin" asp-action="Dashboard">Admin</a> &rsaquo;
            <span class="text-white">Learning resources</span>
        </nav>
        <h1 class="fw-bold">Learning resources</h1>
        <p class="mb-0" style="color: rgba(255,255,255,.82);">Insert, update and delete resource records.</p>
    </div>
</header>

<section class="lh-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <partial name="_AdminNav" />
            </div>

            <div class="col-lg-9">
                <div class="lh-dash-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <form asp-controller="Admin" asp-action="Resources" method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 380px;">
                            <label for="adminSearch" class="visually-hidden">Search resources</label>
                            <input id="adminSearch" type="search" name="q" value="@ViewBag.Query"
                                   class="form-control lh-form-control" placeholder="Search by title…" />
                            <button type="submit" class="btn btn-lh-primary"><i class="ti ti-search"></i></button>
                        </form>
                        <a asp-controller="Admin" asp-action="CreateResource" class="btn btn-lh-accent">
                            <i class="ti ti-plus me-1"></i>Insert new resource
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle lh-table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Type</th>
                                    <th>Level</th>
                                    <th class="text-center">Featured</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-4">No resources found.</td></tr>
                                }
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.Id</td>
                                        <td>
                                            <a asp-controller="Resources" asp-action="Details" asp-route-id="@r.Id" class="text-decoration-none">
                                                @r.Title
                                            </a>
                                        </td>
                                        <td>@r.Category?.Name</td>
                                        <td><span class="lh-badge lh-badge-type">@r.ResourceType</span></td>
                                        <td>@r.Level</td>
                                        <td class="text-center">
                                            @if (r.IsFeatured)
                                            {
                                                <i class="ti ti-star-filled text-warning" aria-label="Yes"></i>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Admin" asp-action="EditResource" asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="ti ti-pencil"></i><span class="visually-hidden">Edit</span>
                                            </a>
                                            <form asp-controller="Admin" asp-action="DeleteResource" asp-route-id="@r.Id"
                                                  method="post" class="d-inline"
                                                  data-lh-confirm="Delete '@r.Title'? Enrolments and reviews will also be removed.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i><span class="visually-hidden">Delete</span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
